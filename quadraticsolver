from cmath import sqrt

def solve_abcstandard(a,b,c,o):
    # Try to use the quadratic formula, with o deciding if the sqrt is plus or minus for the plusminus
    try:
        return (-1*b + sqrt((b**2)-4*a*c))/(2*a) if o == 1 else (-1*b - sqrt((b**2)-4*a*c))/(2*a)
    except ValueError:
        return("None (Imaginary)")

def standardform(a,b,c):
    
    # Ask for standard form values
    equationabc = f"{a}x^2 + {b}x + {c} = 0"

    # Find answers and return
    answer1 = solve_abcstandard(a,b,c,1)
    answer2 = solve_abcstandard(a,b,c,-1)
    return answer1, answer2

